LISTEN_ADDR=:8090
DATA_DIR=/data
# Production: durable PostgreSQL + volatile 5-minute Redis hash cache.
# Empty DATABASE_URL keeps SQLite only for offline migration/development.
DATABASE_URL=postgres://uploader:CHANGE_ME@postgres:5432/uploader?sslmode=disable
POSTGRES_PASSWORD=CHANGE_ME
REDIS_URL=redis://redis:6379/0
RECEIVE_CONCURRENCY=30
UPLOAD_CONCURRENCY=10
UPLOAD_MAX_CONCURRENCY=500
BATCH_SIZE=30
BATCH_INTERVAL=30m
WORKER_MODE=reverse
SPOOL_MAX_BYTES=1073741824
MAX_FILE_BYTES=10485760
MAX_GROUP_BYTES=524288000
MIN_FREE_BYTES=268435456
# Drop never-finished groups after this many hours so their spool space returns.
# 0 disables the cleanup; clients resume the same upload ID on retry.
STALE_UPLOAD_HOURS=6
PAN_CLIENT_ID=
PAN_CLIENT_SECRET=
PAN_PARENT_FILE_ID=0
PAN_API_BASE=https://open-api.123pan.com
# Required only with WORKER_MODE=forward (compatibility mode).
WORKER_WS_URL=
WORKER_TOKEN=
# Optional Cloudflare Access service token; application authentication still applies.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
# Public node C base URL for historical JSON submissions and statistics reads.
STATISTICS_PUBLIC_URL=
